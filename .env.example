# Salin menjadi .env (JANGAN di-commit). Nilai produksi diisi di Vercel > Settings > Environment Variables.
# Secret untuk melindungi /api/tick (minimal 16 karakter acak):
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
CRON_SECRET=
# Vercel Blob (storage utama). Terpasang otomatis di Vercel saat Blob store dihubungkan ke project.
# Untuk skrip lokal (export_logs, kill_switch, log_bugfix) salin dari Vercel > Storage > store > .env.local
BLOB_READ_WRITE_TOKEN=
# Alternatif storage: Upstash Redis REST (kosongkan bila memakai Blob)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Kill switch lewat env (butuh redeploy). Cara utama tanpa redeploy: scripts/kill_switch.py on
KILL_SWITCH=0
# URL deployment untuk scripts/smoke_test.py
BOT_URL=https://indodax-dryrun.vercel.app
